{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "$ref": "#/definitions/Data",
    "definitions": {
        "Data": {
            "title": "Data Definition",
            "type": "object",
            "properties": {
                "types": {
                    "$ref": "#/definitions/Types"
                }
            },
            "additionalProperties": false
        },
        "TextForUser": {
            "title": "Specification details - DETAILED TEXTS PROVIDED TO USER",
            "anyOf": [
                {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                {
                    "type": "string"
                }
            ]
        },
        "SpecKV": {
            "$ref": "#/definitions/TextForUser"
        },
        "Types": {
            "title": "Type Definitions",
            "type": "object",
            "properties": {
                "Desktop": {
                    "$ref": "#/definitions/Desktop"
                },
                "Digital_Video__Audio": {
                    "$ref": "#/definitions/DigitalVideoAudio"
                },
                "Mobile": {
                    "$ref": "#/definitions/Mobile"
                },
                "Broadcast": {
                    "$ref": "#/definitions/Broadcast"
                }
            },
            "additionalProperties": false
        },
        "UI": {
            "title": "Type's UI definition",
            "type": "object",
            "properties": {
                "style": {
                    "type": "string"
                },
                "icon": {
                    "type": "string"
                },
                "alt": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            },
            "required": [
                "style",
                "icon",
                "alt",
                "name"
            ],
            "additionalProperties": false
        },
        "subtypeDetails": {
            "title": "Subtitle's details definition",
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "spec": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Spec"
                    }
                }
            },
            "required": [
                "name",
                "spec"
            ],
            "additionalProperties": false
        },
        "Spec": {
            "title": "Specification definition",
            "type": "object",
            "properties": {
                "ID": {
                    "description": "valid css selector, used as node identifier",
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                },
                "UnitName": {
                    "description": "item name, text only",
                    "type": "string"
                },
                "Type": {
                    "title": "Ad type",
                    "description": "valid css selector, used as node identifier and class name",
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
                },
                "Subtype": {
                    "title": "Ad subtype",
                    "description": "valid css selector, used as node identifier and class name",
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
                },
                "Image": {
                    "description": "ad screenshot/representation filename.ext, no path",
                    "type": "string"
                },
                "Details": {
                    "description": "spec information that will be generated",
                    "$ref": "#/definitions/SpecSections"
                }
            },
            "required": [
                "ID",
                "UnitName",
                "Image",
                "Details"
            ],
            "additionalProperties": false
        },
        "TBD_listOfObject": {
            "type":"object"
        },
        "SpecSections": {
            "title": "Specification details",
            "type": "object",
            "properties": {
                "Dimensions": {
                    "$ref": "#/definitions/TBD_listOfObject"
                },
                "Load": {
                    "$ref": "#/definitions/TBD_listOfObject"
                },
                "Formats": {
                    "$ref": "#/definitions/TBD_listOfObject"
                },
                "Animation and Video": {
                    "$ref": "#/definitions/TBD_listOfObject"
                },
                "Content Information": {
                    "$ref": "#/definitions/TBD_listOfObject"
                },
                "Additional Notes": {
                    "$ref": "#/definitions/AdditionalNotes"
                }
            },
            "additionalProperties": true
        },
        "AdditionalNotes": {
            "title": "Specification details - Additional Notes",
            "TODO": "ADD MORE - up to TextForUser",
            "type": "object",
            "properties": {
                "Sites": {
